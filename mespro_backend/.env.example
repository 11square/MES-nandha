# Environment
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mespro
DB_USER=root
DB_PASSWORD=Vishnu@1993
DB_DIALECT=mysql

# JWT
JWT_SECRET=change-this-to-a-strong-secret
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────────
# e-Way Bill integration (NIC / GSP)
#
# The feature is INERT until EWB_ENABLED=true AND all required keys below are
# set. Until then, the e-Way Bill endpoints return HTTP 501 and nothing else in
# the app is affected. NIC direct API access usually requires a GSP or turnover
# > Rs.100Cr, IP whitelisting, an API-enabled GSTIN, and the NIC RSA public key.
# ─────────────────────────────────────────────────────────────────────────────
EWB_ENABLED=false
EWB_BASE_URL=
EWB_AUTH_PATH=/ewayapi/authenticate
EWB_API_PATH=/ewayapi
EWB_CLIENT_ID=
EWB_CLIENT_SECRET=
EWB_GSTIN=
EWB_USERNAME=
EWB_PASSWORD=
# NIC/GSP RSA public key (base64 single-line or full PEM)
EWB_PUBLIC_KEY=

# Seller / consignor profile (your own company — the "from" party on the EWB)
EWB_SELLER_GSTIN=
EWB_SELLER_NAME=
EWB_SELLER_ADDR1=
EWB_SELLER_ADDR2=
EWB_SELLER_PLACE=
EWB_SELLER_PINCODE=
# 2-digit GST state code; auto-derived from EWB_SELLER_GSTIN if left blank
EWB_SELLER_STATE_CODE=
